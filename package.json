{
  "name": "davomat-server",
  "version": "1.0.0",
  "private": true,
  "description": "Xodimlar davomati - backend (Express + Prisma)",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:prod": "node scripts/check-env.js && node scripts/wait-for-db.js && prisma migrate deploy && node src/index.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "studio": "prisma studio",
    "use:sqlite": "node scripts/switch-db.js sqlite",
    "use:postgres": "node scripts/switch-db.js postgresql",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
