# ══════════════════════════════════════════════════════════════════
#  Ishlab chiqish (lokal) uchun namuna. Nusxa oling:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Ma'lumotlar bazasi ──────────────────────────────────────────────
# PostgreSQL (standart):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davomat?schema=public"
#
# SQLite (soddaroq variant) — avval `npm run use:sqlite` buyrug'ini bajaring,
# so'ng quyidagi qatorni yoqing va yuqoridagini izohga oling:
# DATABASE_URL="file:./dev.db"
#
# Railway'da: PostgreSQL xizmatini qo'shsangiz, DATABASE_URL avtomatik beriladi.
# Xizmat o'zgaruvchisi sifatida ${{Postgres.DATABASE_URL}} deb bog'lang.

# ── JWT ─────────────────────────────────────────────────────────────
# Ishlab chiqarishda ALBATTA uzun tasodifiy qatorga almashtiring!
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="bu-maxfiy-kalitni-albatta-ozgartiring"
JWT_EXPIRES_IN="8h"

# ── Server ──────────────────────────────────────────────────────────
# Railway PORT ni o'zi beradi — u yerda bu o'zgaruvchini QO'LDA qo'ymang.
PORT=4000

# ── Vaqt mintaqasi ──────────────────────────────────────────────────
# MUHIM: hali tugallanmagan seanslar ("Geldi" bor, "Gitdi" yo'q) joriy
# vaqtgacha hisoblanadi. Server UTC'da ishlasa (Railway'da standart shunday),
# bu hisob noto'g'ri chiqadi. Shuning uchun TZ ni qo'ying:
TZ="Asia/Ashgabat"

# Frontend manzili (CORS). Vergul bilan bir nechtasini yozish mumkin,
# `*` belgisi ham ishlaydi (Vercel preview deploylari uchun qulay):
#   CORS_ORIGIN="https://davomat.vercel.app,https://*.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# ── Seed (birinchi admin) ───────────────────────────────────────────
# Ishlab chiqarishda seed ishga tushirishdan OLDIN kuchli parol qo'ying.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin123"
