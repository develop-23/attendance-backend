# ══════════════════════════════════════════════════════════════════
#  Sample for local development. Copy it:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────
# PostgreSQL (default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance?schema=public"
#
# SQLite (the simpler option) — first run `npm run use:sqlite`,
# then enable the line below and comment out the one above:
# DATABASE_URL="file:./dev.db"
#
# On Railway: once you add the PostgreSQL service, DATABASE_URL is provided
# automatically. Link it as a service variable: ${{Postgres.DATABASE_URL}}.

# ── JWT ─────────────────────────────────────────────────────────────
# In production you MUST replace this with a long random string!
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-secret-key-for-sure"
JWT_EXPIRES_IN="8h"

# ── Server ──────────────────────────────────────────────────────────
# Railway supplies PORT itself — do NOT set this variable by hand there.
PORT=4000

# ── Time zone ───────────────────────────────────────────────────────
# IMPORTANT: unfinished sessions (with a "Geldi" but no "Gitdi") are counted up
# to the current time. If the server runs in UTC (the default on Railway) that
# calculation comes out wrong. So set TZ:
TZ="Asia/Ashgabat"

# Frontend address (CORS). Several can be listed separated by commas, and the
# `*` wildcard works too (handy for Vercel preview deployments):
#   CORS_ORIGIN="https://davomat.vercel.app,https://*.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# ── Seed (the first admin) ──────────────────────────────────────────
# In production, set a strong password BEFORE running the seed.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin123"
