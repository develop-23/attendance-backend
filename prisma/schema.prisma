// Prisma schema — employee attendance
// To switch the provider: npm run use:sqlite / npm run use:postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Administrators. This is the only kind of "user" in the system —
/// employees have their own accounts in the separate Employee table.
model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  attendanceUpdates Attendance[] @relation("AttendanceUpdatedByUser")
  auditLogs         AuditLog[]
}

/// Employees. Each of them signs in with their own login/password and
/// enters their own check-in/check-out times.
model Employee {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  fullName     String
  position     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  attendances       Attendance[]
  attendanceUpdates Attendance[] @relation("AttendanceUpdatedByEmployee")
  auditLogs         AuditLog[]

  @@index([isActive])
  @@index([fullName])
}

/// A SINGLE check-in/check-out session.
/// An employee may come and go several times a day, so there is NO unique index
/// on (employeeId, date) — one day can hold several records.
/// date is stored as text in the form "YYYY-MM-DD" and checkIn/checkOut as
/// "HH:MM" — this behaves identically on SQLite and PostgreSQL and removes the
/// problem of days shifting because of the time zone.
model Attendance {
  id                  Int      @id @default(autoincrement())
  employeeId          Int
  date                String // YYYY-MM-DD
  checkIn             String // HH:MM — start of the session, required
  checkOut            String? // HH:MM — null if they have not left yet
  note                String?
  updatedByUserId     Int? // set when an admin edited it
  updatedByEmployeeId Int? // set when the employee entered it themselves
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedByUser     User?     @relation("AttendanceUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("AttendanceUpdatedByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([date])
}

/// Change history. The action can be performed by an admin as well as an employee.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int? // admin
  employeeId Int? // employee
  action     String // create | update | delete | login | change-password
  entity     String // Employee | Attendance | User | Settings
  entityId   String?
  oldValue   String? // JSON text
  newValue   String? // JSON text
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Global settings (single-row table, id = 1)
model Settings {
  id               Int      @id @default(1)
  workStart        String   @default("09:00") // work start time
  workEnd          String   @default("18:00") // work end time
  lateThresholdMin Int      @default(0) // lateness threshold (minutes)
  weekendDays      String   @default("6,7") // 1=Monday ... 7=Sunday
  updatedAt        DateTime @updatedAt
}
